generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model RepositoryAnalysis {
  id                 String   @id @default(cuid())
  repositoryUrl      String
  repositoryOwner    String
  repositoryName     String
  repositoryFullName String

  defaultBranch      String?

  analysisData       Json

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documents          Documentation[]

  @@index([repositoryOwner, repositoryName])
  @@index([createdAt])
}

model Documentation {
  id                   String   @id @default(cuid())

  repositoryAnalysisId String
  repositoryAnalysis   RepositoryAnalysis @relation(fields: [repositoryAnalysisId], references: [id], onDelete: Cascade)

  markdown             String
  sections             Json
  metadata             Json

  qualityScore         Int?
  qualityData          Json?
  qualityEvaluatedAt   DateTime?

  generatedProvider    String?
  generatedModel       String?

  generationTimeMs     Int?
  attemptCount         Int?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  improvementProposals DocumentationImprovementProposal[]
  versions             DocumentationVersion[]

  @@index([repositoryAnalysisId])
  @@index([updatedAt])
}

model DocumentationImprovementProposal {
  id                 String        @id @default(cuid())
  documentId         String
  documentation      Documentation @relation(fields: [documentId], references: [id], onDelete: Cascade)
  issueId            String
  targetSection      String?
  currentContentHash String
  proposedContent    String
  explanation        String?
  createdAt          DateTime      @default(now())
  expiresAt          DateTime
  appliedAt          DateTime?

  @@index([documentId])
}

model DocumentationVersion {
  id            String                     @id @default(cuid())
  documentId    String
  document      Documentation              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  markdown      String
  contentHash   String
  sections      Json?
  metadata      Json?
  qualityScore  Int?
  qualityData   Json?
  sourceType    DocumentationVersionSource
  sourceLabel   String?
  createdAt     DateTime                   @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
}

enum DocumentationVersionSource {
  INITIAL_GENERATION
  MANUAL_EDIT
  SECTION_REGENERATION
  FULL_REGENERATION
  QUALITY_IMPROVEMENT
  RESTORE
}

